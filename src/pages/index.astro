---
import Base from '../layouts/Base.astro';
import Capabilities from '../components/Capabilities';
import Control from '../components/Control';
import Facts from '../components/Facts.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header';
import HeroText from '../components/HeroText';
import Modes from '../components/Modes';
import SectionHeading from '../components/SectionHeading';
import { capabilities, site } from '../data/site';

/*
 * Скрипт получают только два компонента: шапка (на узком экране — боковое меню) и вкладки
 * возможностей. Остальное — разметка, отрисованная при сборке.
 */
---

<Base title={site.title} description={site.description}>
    <Header client:media="(max-width: 899px)" />
    <main>
        <section id="top" class="hero">
            <div class="container">
                <HeroText />
            </div>
        </section>
        <Facts />
        <section id="capabilities" class="section section--light capabilities">
            <div class="container">
                <SectionHeading title={capabilities.title} />
                <Capabilities client:visible />
            </div>
        </section>
        <section id="control" class="section section--dark">
            <div class="container">
                <Control />
            </div>
        </section>
        <section id="modes" class="section section--light">
            <div class="container">
                <Modes />
            </div>
        </section>
    </main>
    <Footer />
</Base>
