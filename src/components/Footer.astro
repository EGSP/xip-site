---
import { footer, sections, site } from '../data/site';
---

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__top">
            <div>
                <a class="brand" href="#top" aria-label={`${site.name}: в начало страницы`}>
                    <span class="brand__name">{site.name}</span>
                </a>
                <p class="site-footer__about">{footer.about}</p>
            </div>
            <nav class="site-footer__nav" aria-label="Разделы страницы">
                {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
            </nav>
        </div>
        <div class="site-footer__bottom">
            <span>{footer.copyright}</span>
            <span>{footer.colophon}</span>
        </div>
    </div>
</footer>
